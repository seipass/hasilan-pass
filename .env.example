# Copy this file to .env to customize Docker Compose.
# `docker compose up --build --detach` works without it and generates all secrets.
HP_HTTP_PORT=8080
HP_DATABASE_NAME=hasilan
HP_DATABASE_USER=hasilan
HP_PUBLIC_URL=http://localhost:8080
HP_ALLOWED_ORIGINS=http://localhost:8080
HP_WEBAUTHN_ORIGIN=http://localhost:8080
HP_WEBAUTHN_RP_ID=localhost
HP_WEBAUTHN_RP_NAME=Hasilan Pass
# Packaged Chromium and Firefox origins are fixed by extension/manifest.json. Keep only origins you deploy.
# To use Android account passkeys, append the explicit certificate-bound origin:
# android:apk-key-hash:<base64url-sha256-of-the-APK-signing-certificate>
HP_WEBAUTHN_ADDITIONAL_ORIGINS=chrome-extension://idknmeojelkflflogppfklcfbfamnbnb,moz-extension://ihkchkcogibgnbilcnedillnbfijofddbmgmjhlhphajhngcmbkngbblcmeelhph
HP_PRODUCTION=false
HP_ACCESS_TOKEN_TTL_SECONDS=900
HP_REFRESH_TOKEN_TTL_SECONDS=2592000
HP_TRUSTED_DEVICE_TTL_SECONDS=2592000
# Opaque encrypted bytes per attachment (default 1 GiB, hard maximum 64 GiB).
HP_ATTACHMENT_MAX_BYTES=1073741824
# Invitation delivery defaults to a one-time token shown to an administrator.
HP_INVITATION_DELIVERY=manual
# TLS-only SMTP alternative (uncomment all required fields together):
# HP_INVITATION_DELIVERY=smtp
# HP_SMTP_HOST=smtp.example.com
# HP_SMTP_PORT=587
# HP_SMTP_TLS=starttls
# HP_SMTP_FROM=Hasilan Pass <noreply@example.com>
# HP_SMTP_USERNAME=smtp-user
# Prefer a mounted secret file. HP_SMTP_PASSWORD is supported for direct process managers.
# HP_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# HP_SMTP_TIMEOUT_SECONDS=10
RUST_LOG=hasilan_server=info,tower_http=info

# Android release signing (optional; debug builds use an auto-generated key)
# HP_ANDROID_KEYSTORE=/secure/path/hasilan-release.jks
# HP_ANDROID_KEYSTORE_PASSWORD=…
# HP_ANDROID_KEY_ALIAS=…
# HP_ANDROID_KEY_PASSWORD=…
# Verified App Link host for deep-link callback (default is invalid; set only for a public host)
# HP_ANDROID_APP_LINK_HOST=passwords.example.com

# Production: set a public DNS name, then use both Compose files. Caddy obtains
# and renews TLS certificates automatically; ports 80 and 443 must reach this host.
# HP_HOSTNAME=passwords.example.com

# Direct (non-Compose) server development additionally requires these values.
# Never reuse the two server secrets, and never commit their real values.
# DATABASE_URL=postgres://hasilan:hasilan_dev@127.0.0.1:5432/hasilan
# HP_BIND=127.0.0.1:8080
# HP_TOKEN_PEPPER=<unpadded-base64url-encoding-of-32-random-bytes>
# HP_MFA_ENCRYPTION_KEY=<different-unpadded-base64url-encoding-of-32-random-bytes>
