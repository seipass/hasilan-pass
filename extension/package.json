{
  "name": "@hasilan/browser-extension",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "pnpm build && playwright test",
    "build:firefox": "pnpm build && node scripts/prepare-firefox.mjs",
    "lint:firefox": "pnpm build:firefox && web-ext lint --source-dir dist",
    "package:firefox": "pnpm build:firefox && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webextension-polyfill": "0.12.6",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.10",
    "web-ext": "10.6.0"
  }
}
